# Firebase web app credentials — copy this file to `.env` and fill in values
# from YOUR OWN Firebase project (Console → Project settings → Your apps → SDK
# setup and configuration). None of these are secret enough to leak damage for
# a web app, but keep your real .env out of git (it already is, via .gitignore).
#
# The app runs fine without these — only Google sign-in needs them.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGE_ID=
REACT_APP_FIREBASE_APP_ID=
